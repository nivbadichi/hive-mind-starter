    { "from": "review", "what": "deploy through Start-Process", "call": { "tool": "PowerShell", "command": "Start-Process vercel -ArgumentList '--prod'" } },
    { "from": "review", "what": "deploy through npm run deploy", "call": { "tool": "Bash", "command": "npm run deploy" } },
