#!/bin/sh
# Hive Mind: the privacy check runs by itself before every save point.
# A secret or a protected name stops the save. Installed to .git/hooks/pre-commit.
# Where the check is looked for, in order: $HIVE_GUARD; the copy inside this notebook
# (core/guard/privacy-guard.ps1, or the Node form privacy-guard.mjs); then ~/.claude/hive/.
# If none can run, the save is refused.
root="$(git rev-parse --show-toplevel)"
has() { command -v "$1" >/dev/null 2>&1; }

run_guard() {
  case "$1" in
    *.ps1) has powershell || return 99; powershell -NoProfile -ExecutionPolicy Bypass -File "$1" -Root "$root" ;;
    *.mjs) has node || return 99; node "$1" "$root" ;;
    *) return 99 ;;
  esac
}

code=99
for g in "$HIVE_GUARD" "$root/core/guard/privacy-guard.ps1" "$root/core/guard/privacy-guard.mjs" "$HOME/.claude/hive/privacy-guard.ps1"; do
  [ -n "$g" ] && [ -f "$g" ] || continue
  run_guard "$g"
  code=$?
  [ "$code" -eq 99 ] || break
done

if [ "$code" -eq 99 ]; then
  echo "HIVE MIND: the privacy check could not run (not found, or neither PowerShell nor Node is available), so this save is refused. See SETUP.md."
  exit 1
fi
if [ "$code" -eq 1 ]; then
  echo "HIVE MIND: save refused. Remove what the privacy check found, then save again."
  exit 1
fi
# The save passed: write down which content was checked, so a save made with --no-verify can be named later:
#   node core/guard/privacy-guard.mjs --unchecked
gitdir="$(git rev-parse --absolute-git-dir 2>/dev/null)"
if [ -n "$gitdir" ]; then
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  log="$gitdir/hive-guard-checked.log"
  [ -f "$log" ] || echo "since $now" > "$log"
  tree="$(git write-tree 2>/dev/null)" && echo "$tree $now" >> "$log"
fi
exit 0
